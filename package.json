{
  "name": "snapds-monorepo",
  "private": false,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -k -n ext,web,cp \"pnpm dev:extension\" \"pnpm dev:webviews\" \"pnpm dev:copy\"",
    "dev:extension": "pnpm --filter snapds run dev",
    "dev:webviews": "pnpm --filter snapds run dev:webviews",
    "dev:landing": "pnpm --filter landing run dev",
    "build:landing": "pnpm --filter landing run build",
    "deploy:landing": "npx wrangler deploy",
    "dev:copy": "chokidar \"extension/webviews/gallery/dist/**\" \"extension/webviews/props/dist/**\" \"extension/webviews/settings/dist/**\" -c \"node scripts/copy-webviews.mjs\"",
    "build": "pnpm -r run build && node scripts/copy-webviews.mjs",
    "test": "pnpm -r run test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "package": "pnpm run build && pnpm --filter snapds run package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "husky": "^9.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data@<4.0.6": "^4.0.6",
      "shell-quote@<1.9.0": "^1.9.0",
      "nanoid@<3.3.17": "^3.3.17",
      "undici@<7.29.0": "^7.29.0",
      "postcss@<8.5.12": "^8.5.23",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "mermaid@>=11.5.0 <11.16.1": "^11.16.1",
      "dompurify@<3.4.13": "^3.4.13"
    }
  }
}
